{
  "name": "@sarkhanrasullu/game-engine",
  "version": "0.4.0",
  "description": "Data-driven 3D fighting-game engine: fixed-step core, deterministic duel sim, fair CPU pilot, input layer, three.js render pipeline, audio and storage primitives. Raw ES modules, no build step.",
  "license": "MIT",
  "author": "sarkhanrasullu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarkhanrasullu/game-engine.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": "./src/core/index.js",
    "./sim": "./src/sim/index.js",
    "./ai": "./src/ai/index.js",
    "./input": "./src/input/index.js",
    "./render": "./src/render/index.js",
    "./audio": "./src/audio/index.js",
    "./storage": "./src/storage/index.js",
    "./assets": "./src/assets/index.js",
    "./assets/gltf-loader": "./src/assets/gltf-loader-stack.js",
    "./tools/*": "./tools/*",
    "./blender/*": "./blender/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tools",
    "blender",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "three": ">=0.187.0 <0.188.0"
  },
  "devDependencies": {
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
